# ===============================================
# VeriRAG — Environment Variables Template
# ===============================================
#
# SECURITY MODEL:
#   1. Copy this file: cp .env.example .env
#   2. For LOCAL DEV: Fill in infrastructure values only (DB, Redis, Vault)
#   3. For AZURE: Set AZURE_KEY_VAULT_URL (Managed Identity handles auth)
#   4. NEVER put secret keys in .env — use Vault or Key Vault
#   5. NEVER commit .env to Git (it's in .gitignore)
#
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  SECURITY RULES:                                                    ║
# ║  - API keys (AZURE_OPENAI_KEY, AZURE_SEARCH_KEY, GROQ_API_KEY)     ║
# ║    must NEVER appear in .env or environment variables              ║
# ║  - Store in HashiCorp Vault (local) or Azure Key Vault (cloud)     ║
# ║  - Application fetches at runtime with proper authentication       ║
# ╚══════════════════════════════════════════════════════════════════════╝
# ===============================================

# --- Deployment Mode ---
# "local" = HashiCorp Vault + Docker Compose + Local PostgreSQL
# "cloud" = Azure Key Vault + Managed Identity + Azure PostgreSQL
DEPLOY_MODE=local

# --- Django Configuration ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,rag-backend

# --- PostgreSQL / Azure Database for PostgreSQL ---
POSTGRES_HOST=rag-db
POSTGRES_DB=verirag_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_PORT=5432

# --- Redis / Azure Cache for Redis (Local Mode) ---
REDIS_URL=redis://rag-redis:6379/0
CELERY_BROKER_URL=redis://rag-redis:6379/0
CELERY_RESULT_BACKEND=redis://rag-redis:6379/0

# --- HashiCorp Vault (Local Mode Only) ---
# Stores API keys securely in local Docker container
# After starting containers, run: ./scripts/setup/init_vault.ps1
VAULT_ADDR=http://rag-vault:8200
VAULT_TOKEN=CHANGE_ME_vault_root_token

# --- Azure Services (Cloud Mode) ---
# DO NOT put actual keys here! Only fill endpoints.
# Keys are stored in Azure Key Vault, fetched via Managed Identity.
AZURE_KEY_VAULT_URL=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4-turbo
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net/
AZURE_SEARCH_INDEX=verirag-documents

# --- CORS & Security ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=verirag-backend

# --- Feature Flags ---
DEMO_MODE=True
USE_SQLITE_FOR_TESTS=False
INGEST_SYNC_ON_UPLOAD=False
INGEST_SYNC_FALLBACK=True
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_DELAY_SECONDS=1.5
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.20

# ===============================================
# PRODUCTION DEPLOYMENT CHECKLIST:
# ===============================================
# [ ] Set DEPLOY_MODE=cloud
# [ ] Set DEBUG=False
# [ ] Generate strong DJANGO_SECRET_KEY (50+ chars)
# [ ] Set AZURE_KEY_VAULT_URL to your Key Vault URL
# [ ] Endpoint vars (AZURE_OPENAI_ENDPOINT, AZURE_SEARCH_ENDPOINT) set
# [ ] Store API keys in Azure Key Vault, NOT here
# [ ] Enable Managed Identity on Container App
# [ ] Grant Key Vault permissions to Managed Identity
# [ ] Point POSTGRES_HOST to Azure PG FQDN
# [ ] Point REDIS_URL to Azure Cache (rediss:// with SSL)
# [ ] Configure proper ALLOWED_HOSTS with your domain
# [ ] Set SECURE_SSL_REDIRECT=True
# [ ] Set SESSION_COOKIE_SECURE=True
# [ ] Set CSRF_COOKIE_SECURE=True
