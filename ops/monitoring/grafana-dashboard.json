{
  "dashboard": {
    "id": 1,
    "uid": "verirag-ops-dashboard",
    "title": "VeriRAG Operations Dashboard",
    "description": "Unified monitoring for Cost, Quality, Drift, and RAG Pipeline metrics",
    "tags": ["verirag", "ops", "monitoring"],
    "timezone": "utc",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Daily Cost (USD)",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(increase(cost_ops_daily_cost_usd[1d]))",
            "legendFormat": "Today's Cost",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "text": {},
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 2,
        "title": "Budget Utilization (%)",
        "type": "gauge",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "(sum(cost_ops_cumulative_cost_usd) / 1000) * 100",
            "legendFormat": "Budget %",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "textMode": "auto",
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "percentage",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 75
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Quality Score (Avg)",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "avg(quality_ops_combined_score)",
            "legendFormat": "Quality Score",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Poor",
                    "color": "red"
                  },
                  "0.5": {
                    "text": "Acceptable",
                    "color": "yellow"
                  },
                  "0.75": {
                    "text": "Good",
                    "color": "light-green"
                  },
                  "0.85": {
                    "text": "Excellent",
                    "color": "green"
                  }
                }
              }
            ],
            "max": 1,
            "min": 0,
            "unit": "short"
          }
        }
      },
      {
        "id": 4,
        "title": "Drift Alerts (Last Hour)",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(increase(drift_ops_alerts_total[1h]))",
            "legendFormat": "Alerts",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Hourly Cost Trend",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "expr": "rate(cost_ops_cumulative_cost_usd[1h])",
            "legendFormat": "Hourly Cost (USD/h)",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "calcs": ["mean", "max"],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              }
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "Quality Score Trend",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "targets": [
          {
            "expr": "avg(quality_ops_combined_score)",
            "legendFormat": "Combined Score",
            "refId": "A"
          },
          {
            "expr": "avg(quality_ops_faithfulness)",
            "legendFormat": "Faithfulness",
            "refId": "B"
          },
          {
            "expr": "avg(quality_ops_answer_relevancy)",
            "legendFormat": "Answer Relevancy",
            "refId": "C"
          }
        ],
        "options": {
          "legend": {
            "calcs": ["mean", "max", "min"],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              }
            },
            "max": 1,
            "min": 0,
            "unit": "short"
          }
        }
      },
      {
        "id": 7,
        "title": "Cost by Operation",
        "type": "piechart",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 10
        },
        "targets": [
          {
            "expr": "sum by (operation) (cost_ops_operation_cost_usd)",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "right",
            "values": []
          },
          "pieType": "pie",
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              }
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 8,
        "title": "Quality Distribution",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 8,
          "y": 10
        },
        "targets": [
          {
            "expr": "sum(quality_ops_tier_excellent_count)",
            "legendFormat": "Excellent",
            "refId": "A"
          },
          {
            "expr": "sum(quality_ops_tier_good_count)",
            "legendFormat": "Good",
            "refId": "B"
          },
          {
            "expr": "sum(quality_ops_tier_acceptable_count)",
            "legendFormat": "Acceptable",
            "refId": "C"
          },
          {
            "expr": "sum(quality_ops_tier_poor_count)",
            "legendFormat": "Poor",
            "refId": "D"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 9,
        "title": "Recent Drift Alerts",
        "type": "table",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 16,
          "y": 10
        },
        "targets": [
          {
            "expr": "topk(10, drift_ops_alerts_total)",
            "legendFormat": "{{alert_type}}",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Time",
              "desc": true
            }
          ]
        }
      },
      {
        "id": 10,
        "title": "RAG Query Latency (ms)",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(rag_query_latency_ms_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(rag_query_latency_ms_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "B"
          },
          {
            "expr": "avg(rate(rag_query_latency_ms_sum[5m])) / avg(rate(rag_query_latency_ms_count[5m]))",
            "legendFormat": "avg",
            "refId": "C"
          }
        ],
        "options": {
          "legend": {
            "calcs": ["mean", "max"],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "ms"
          }
        }
      },
      {
        "id": 11,
        "title": "Query Success Rate (%)",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "100 * (sum(rate(rag_queries_passed[5m])) / sum(rate(rag_queries_total[5m])))",
            "legendFormat": "Success Rate %",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "calcs": ["mean", "min"],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "max": 100,
            "min": 0,
            "unit": "%"
          }
        }
      }
    ],
    "schemaVersion": 38,
    "style": "dark",
    "templating": {
      "list": [
        {
          "current": {
            "selected": false,
            "text": "1h",
            "value": "1h"
          },
          "hide": 0,
          "includeAll": false,
          "label": "Time Range",
          "multi": false,
          "name": "time_range",
          "options": [
            {
              "selected": false,
              "text": "15m",
              "value": "15m"
            },
            {
              "selected": false,
              "text": "1h",
              "value": "1h"
            },
            {
              "selected": false,
              "text": "6h",
              "value": "6h"
            },
            {
              "selected": true,
              "text": "24h",
              "value": "24h"
            }
          ],
          "query": "15m, 1h, 6h, 24h",
          "queryValue": "",
          "skipUrlSync": false,
          "sort": 0,
          "type": "custom"
        }
      ]
    },
    "triggers": []
  }
}
