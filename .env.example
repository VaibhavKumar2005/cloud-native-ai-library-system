# ===============================================
# VeriRAG — Environment Variables Template
# ===============================================
#
# SECURITY MODEL:
#   1. Copy this file: cp .env.example .env
#   2. Fill in INFRASTRUCTURE values only (DB host, Redis URL, Vault address)
#   3. NEVER put API keys here — they live in Vault (local) or Key Vault (cloud)
#   4. NEVER commit .env to Git (it's in .gitignore)
#
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  STRICT RULE: GOOGLE_API_KEY and GROQ_API_KEY must NEVER appear    ║
# ║  in this file, in .env, or in any environment variable.            ║
# ║  They are stored in HashiCorp Vault (local) or Azure Key Vault     ║
# ║  (cloud) and fetched at runtime by the application.                ║
# ╚══════════════════════════════════════════════════════════════════════╝
# ===============================================

# --- Deployment Mode ---
# "local" = HashiCorp Vault container + local Redis + local PG
# "cloud" = Azure Key Vault + Azure Cache for Redis + Azure PG Flexible
DEPLOY_MODE=local

# --- Django Configuration ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,rag-backend

# --- PostgreSQL (Local Mode) ---
POSTGRES_HOST=rag-db
POSTGRES_DB=verirag_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_PORT=5432

# --- Redis & Celery (Local Mode) ---
REDIS_URL=redis://rag-redis:6379/0
CELERY_BROKER_URL=redis://rag-redis:6379/0
CELERY_RESULT_BACKEND=redis://rag-redis:6379/0

# --- HashiCorp Vault (Local Mode) ---
# The ONLY way API keys reach the application.
# After starting containers, run: ./init_vault.ps1
VAULT_ADDR=http://rag-vault:8200
VAULT_TOKEN=CHANGE_ME_vault_root_token

# --- Azure Key Vault (Cloud Mode — uncomment when deploying to Azure) ---
# AZURE_KEY_VAULT_URL=https://kv-verirag-dev.vault.azure.net/

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- MongoDB (optional) ---
MONGO_URI=mongodb://rag-mongo:27017/verirag

# ===============================================
# PRODUCTION DEPLOYMENT CHECKLIST:
# ===============================================
# [ ] Set DEPLOY_MODE=cloud
# [ ] Set DEBUG=False
# [ ] Generate strong DJANGO_SECRET_KEY (50+ chars)
# [ ] Point POSTGRES_HOST to Azure PG FQDN
# [ ] Point REDIS_URL to Azure Cache for Redis (rediss:// with SSL)
# [ ] Set AZURE_KEY_VAULT_URL
# [ ] Remove VAULT_ADDR and VAULT_TOKEN (not used in cloud mode)
# [ ] Ensure GOOGLE_API_KEY and GROQ_API_KEY are in Azure Key Vault
# [ ] Configure proper ALLOWED_HOSTS with your domain
