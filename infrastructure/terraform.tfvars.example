###############################################################################
# VeriRAG — Terraform Variables Template
#
# INSTRUCTIONS:
#   1. Copy this file: cp terraform.tfvars.example terraform.tfvars
#   2. Fill in your actual values
#   3. NEVER commit terraform.tfvars to Git (it's in .gitignore)
#   4. For CI/CD, use TF_VAR_ environment variables instead
#
# All sensitive values are marked — they must come from a secure source:
#   - GitHub Actions: Repository Secrets
#   - Local dev: terraform.tfvars (gitignored)
#   - Azure DevOps: Variable Groups (linked to Key Vault)
###############################################################################

# ── Region & Naming ────────────────────────────────────────────────────────
location     = "centralindia"
project_name = "verirag"
environment  = "dev"
acr_name     = "acrvaibhavrag2026"

# ── PostgreSQL Credentials (SENSITIVE) ─────────────────────────────────────
# pg_admin_user     = "veriragadmin"
# pg_admin_password = "<GENERATE_A_STRONG_PASSWORD>"

# ── Django Secret Key (SENSITIVE) ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# django_secret_key = "<GENERATED_TOKEN>"
